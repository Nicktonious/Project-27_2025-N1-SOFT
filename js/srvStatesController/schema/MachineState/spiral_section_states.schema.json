{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpiralSectionState",
  "description": "JSON Schema для состояния спиральной секции (SpiralSectionState), расширяющая базовую схему секции",
  "allOf": [
    {
      "$ref": "./base_section_states.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "Lift": {
          "$ref": "#/definitions/LiftState"
        },
        "DeliveryBox": {
          "$ref": "#/definitions/DeliveryBoxState"
        }
      },
      "required": ["Lift", "DeliveryBox"]
    }
  ],
  "definitions": {
    "LIFT_STATE": {
      "title": "LIFT_STATE",
      "description": "Флаги состояния лифта (OK - в норме, OVERLOAD - перегрузка, BLOCKED - недоступен, SHORT_CIRCUIT - короткое замыкание, NO_POWER - отсутствует питание, ERR_TAMPER - тампер вышел из строя, ERR_LEVEL - неисправен датчик уровня, ERR_MECHANICAL - механическая поломка)",
      "type": "string",
      "enum": [
        "OK",
        "OVERLOAD",
        "BLOCKED",
        "SHORT_CIRCUIT",
        "NO_POWER",
        "ERR_TAMPER",
        "ERR_LEVEL",
        "ERR_MECHANICAL"
      ],
      "tsEnumNames": [
        "OK",
        "OVERLOAD",
        "BLOCKED",
        "SHORT_CIRCUIT",
        "NO_POWER",
        "ERR_TAMPER",
        "ERR_LEVEL",
        "ERR_MECHANICAL"
      ]
    },
    "LiftState": {
      "title": "LiftState",
      "description": "Состояние лифта спиральной секции (Status, Resource)",
      "type": "object",
      "properties": {
        "Status": {
          "$ref": "#/definitions/LIFT_STATE"
        },
        "Resource": {
          "$ref": "./base_section_states.schema.json#/definitions/AVAILABLE_STATE"
        }
      },
      "required": ["Status", "Resource"],
      "additionalProperties": false
    },
    "DELIVERY_BOX_STATE": {
      "title": "DELIVERY_BOX_STATE",
      "description": "Флаги состояния лючка выдачи (OPENED - люк открыт, CLOSED - люк закрыт, ERR_MECHANICAL - механическая поломка)",
      "type": "string",
      "enum": ["OPENED", "CLOSED", "ERR_MECHANICAL"],
      "tsEnumNames": ["OPENED", "CLOSED", "ERR_MECHANICAL"]
    },
    "DeliveryBoxState": {
      "title": "DeliveryBoxState",
      "description": "Состояние лючка выдачи спиральной секции (Status, Resource)",
      "type": "object",
      "properties": {
        "Status": {
          "$ref": "#/definitions/DELIVERY_BOX_STATE"
        },
        "Resource": {
          "$ref": "./base_section_states.schema.json#/definitions/AVAILABLE_STATE"
        }
      },
      "required": ["Status", "Resource"],
      "additionalProperties": false
    }
  }
}
