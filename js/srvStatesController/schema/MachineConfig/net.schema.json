{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NetConfig",
  "description": "Сетевые настройки оборудования и сервисов ПО",
  "type": "object",
  "properties": {
    "Common": {
      "type": "object",
      "description": "Общие сетевые параметры",
      "properties": {
        "mask": {
          "type": "string",
          "description": "Сетевая маска (например, '255.255.255.0')"
        },
        "gw": {
          "type": "string",
          "description": "Сетевой шлюз"
        }
      },
      "required": [
        "mask",
        "gw"
      ],
      "additionalProperties": false
    },
    "Router": {
      "$ref": "#/definitions/RouterConfig"
    },
    "Switch": {
      "$ref": "#/definitions/SwitchConfig"
    },
    "Hub": {
      "type": "object",
      "description": "IP-адреса управляющих микрокомпьютеров (хабов)",
      "properties": {
        "Low": {
          "type": "object",
          "properties": {
            "IP": {
              "type": "string"
            },
            "CpuTempChannel": {
              "type": "string",
              "description": "Канал температуры процессора хаба"
            }
          },
          "required": [
            "IP"
          ],
          "additionalProperties": false
        },
        "Mid": {
          "type": "object",
          "properties": {
            "IP": {
              "type": "string"
            }
          },
          "required": [
            "IP"
          ],
          "additionalProperties": false
        },
        "High": {
          "type": "object",
          "properties": {
            "IP": {
              "type": "string"
            }
          },
          "required": [
            "IP"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "Low",
        "Mid",
        "High"
      ],
      "additionalProperties": false
    },
    "SW": {
      "type": "object",
      "description": "Сетевые параметры серверного ПО и сервисов",
      "properties": {
        "LOW": {
          "type": "object",
          "properties": {
            "REDIS": {
              "type": "object",
              "properties": {
                "IP": {
                  "type": "string"
                },
                "PORT": {
                  "type": "string"
                }
              },
              "required": [
                "IP",
                "PORT"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "REDIS"
          ],
          "additionalProperties": false
        },
        "MID": {
          "type": "object",
          "properties": {
            "MQTT": {
              "type": "object",
              "properties": {
                "IP": {
                  "type": "string"
                },
                "PORT": {
                  "type": "string"
                },
                "WS_PORT": {
                  "type": "string"
                },
                "CLIENT_URL": {
                  "type": "string"
                }
              },
              "required": [
                "IP",
                "PORT",
                "WS_PORT",
                "CLIENT_URL"
              ],
              "additionalProperties": false
            },
            "MONGODB": {
              "type": "object",
              "properties": {
                "IP": {
                  "type": "string"
                },
                "PORT": {
                  "type": "string"
                }
              },
              "required": [
                "IP",
                "PORT"
              ],
              "additionalProperties": false
            },
            "NTP": {
              "type": "object",
              "properties": {
                "IP": {
                  "type": "string"
                },
                "PORT": {
                  "type": "string"
                }
              },
              "required": [
                "IP",
                "PORT"
              ],
              "additionalProperties": false
            },
            "GRAYLOG": {
              "type": "object",
              "properties": {
                "IP": {
                  "type": "string"
                },
                "WEB": {
                  "type": "object",
                  "properties": {
                    "PORT": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "PORT"
                  ],
                  "additionalProperties": false
                },
                "INPUT": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "PORT": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "PORT"
                    ],
                    "additionalProperties": false
                  }
                },
                "URL": {
                  "type": "string"
                }
              },
              "required": [
                "IP",
                "WEB",
                "INPUT",
                "URL"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "MQTT",
            "MONGODB",
            "NTP",
            "GRAYLOG"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "LOW",
        "MID"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "Common",
    "Router",
    "Switch",
    "Hub",
    "SW"
  ],
  "additionalProperties": false,
  "definitions": {
    "WAN_MODE": {
      "title": "WAN_MODE",
      "description": "Режим работы WAN-порта (static - статический IP, dhcp - динамический IP)",
      "type": "string",
      "enum": [
        "static",
        "dhcp"
      ],
      "tsEnumNames": [
        "STATIC",
        "DHCP"
      ]
    },
    "NetPowerDeviceConfig": {
      "title": "NetPowerDeviceConfig",
      "description": "Параметры электропитания сетевого устройства",
      "type": "object",
      "properties": {
        "Bus": {
          "type": "number",
          "description": "Номер шины электропитания"
        },
        "Voltage": {
          "type": "number",
          "description": "Напряжение электропитания, В"
        },
        "CurrentMax": {
          "type": "number",
          "description": "Максимальный потребляемый ток, А"
        },
        "Power": {
          "type": "number",
          "description": "Мощность потребления, Вт"
        }
      },
      "required": [
        "Bus",
        "Voltage",
        "CurrentMax",
        "Power"
      ],
      "additionalProperties": false
    },
    "NetPortConfig": {
      "title": "NetPortConfig",
      "description": "Параметры порта сетевого устройства",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Имя порта"
        },
        "poe": {
          "type": "boolean",
          "description": "Флаг наличия/активности PoE"
        }
      },
      "required": [
        "name",
        "poe"
      ],
      "additionalProperties": false
    },
    "WanConfig": {
      "title": "WanConfig",
      "description": "Конфигурация внешнего сетевого интерфейса (WAN)",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Имя uplink-порта"
        },
        "mode": {
          "$ref": "#/definitions/WAN_MODE"
        },
        "ip": {
          "type": "string",
          "description": "IP-адрес (для static режима)"
        },
        "mask": {
          "type": "string",
          "description": "Сетевая маска (для static режима)"
        },
        "gw": {
          "type": "string",
          "description": "Шлюз (для static режима)"
        },
        "dns": {
          "type": "array",
          "description": "Список IP-адресов DNS-серверов",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "mode"
      ],
      "additionalProperties": false
    },
    "RouterConfig": {
      "title": "RouterConfig",
      "description": "Конфигурация сетевого роутера",
      "type": "object",
      "properties": {
        "RefDes": {
          "type": "string",
          "description": "Обозначение роутера на монтажной схеме"
        },
        "Power": {
          "$ref": "#/definitions/NetPowerDeviceConfig"
        },
        "WAN": {
          "$ref": "#/definitions/WanConfig"
        },
        "port": {
          "type": "array",
          "description": "Список портов роутера",
          "items": {
            "$ref": "#/definitions/NetPortConfig"
          }
        }
      },
      "required": [
        "RefDes",
        "Power",
        "WAN",
        "port"
      ],
      "additionalProperties": false
    },
    "SwitchConfig": {
      "title": "SwitchConfig",
      "description": "Конфигурация сетевого коммутатора",
      "type": "object",
      "properties": {
        "RefDes": {
          "type": "string",
          "description": "Обозначение коммутатора на монтажной схеме"
        },
        "Model": {
          "type": "string",
          "description": "Модель коммутатора"
        },
        "PortsTotal": {
          "type": "number",
          "description": "Общее количество портов коммутатора"
        },
        "Power": {
          "$ref": "#/definitions/NetPowerDeviceConfig"
        }
      },
      "required": [
        "RefDes",
        "Model",
        "PortsTotal",
        "Power"
      ],
      "additionalProperties": false
    }
  }
}
