{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnvConfig",
  "description": "Конфигурация подсистемы климатического контроля",
  "type": "object",
  "properties": {
    "Temp": {
      "type": "array",
      "description": "Список датчиков температуры",
      "items": {
        "$ref": "#/definitions/TempSensorConfig"
      }
    },
    "Hum": {
      "type": "array",
      "description": "Список датчиков влажности",
      "items": {
        "$ref": "#/definitions/HumSensorConfig"
      }
    }
  },
  "required": [
    "Temp",
    "Hum"
  ],
  "additionalProperties": false,
  "definitions": {
    "TempSensorConfig": {
      "title": "TempSensorConfig",
      "description": "Конфигурация датчика температуры",
      "type": "object",
      "properties": {
        "RefDes": {
          "type": "string",
          "description": "Обозначение датчика температуры на монтажной схеме"
        },
        "Model": {
          "type": "string",
          "description": "Модель датчика температуры"
        },
        "Min": {
          "type": "number",
          "description": "Минимальная рабочая температура, °C (по умолчанию 0)"
        },
        "Max": {
          "type": "number",
          "description": "Максимальная рабочая температура, °C (по умолчанию 40)"
        },
        "Field": {
          "$ref": "./field.schema.json#/definitions/FieldRef"
        }
      },
      "required": [
        "RefDes",
        "Model",
        "Min",
        "Max",
        "Field"
      ],
      "additionalProperties": false
    },
    "HumSensorConfig": {
      "title": "HumSensorConfig",
      "description": "Конфигурация датчика влажности",
      "type": "object",
      "properties": {
        "RefDes": {
          "type": "string",
          "description": "Обозначение датчика влажности на монтажной схеме"
        },
        "Model": {
          "type": "string",
          "description": "Модель датчика влажности"
        },
        "Min": {
          "type": "number",
          "description": "Минимальная рабочая влажность, % (по умолчанию 10)"
        },
        "Max": {
          "type": "number",
          "description": "Максимальная рабочая влажность, % (по умолчанию 80)"
        },
        "Field": {
          "$ref": "./field.schema.json#/definitions/FieldRef"
        }
      },
      "required": [
        "RefDes",
        "Model",
        "Min",
        "Max",
        "Field"
      ],
      "additionalProperties": false
    }
  }
}
